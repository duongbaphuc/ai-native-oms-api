# Auto-normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly declare text files
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Binary files
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.gif binary
